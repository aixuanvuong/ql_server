# filepath: backend/.env.example
# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND MÁY CHỦ UBUNTU
# Sao chép file này thành .env trong thư mục backend: cp .env.example .env
# ==============================================================================

# 1. CỔNG MẠNG VÀ BẢO MẬT HỆ THỐNG
PORT=5000
JWT_SECRET=your_jwt_secret_random_key_here_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Mật khẩu Sudo (Dùng cho AI Autonomous Agent tự động thực thi các lệnh root: apt, systemctl, reboot...)
SUDO_PASSWORD=your_sudo_root_password_here

# 2. CẤU HÌNH ĐỊNH TUYẾN AI QUA OMNIROUTE (TƯƠNG THÍCH OPENAI SDK)
# Base URL cố định được tích hợp sẵn: https://omniroute.xuanvuong.id.vn/v1

# Mã khóa API xác thực với máy chủ OmniRoute của bạn
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# Tên mô hình AI bạn muốn sử dụng (ví dụ: gpt-4o, claude-3-5-sonnet, claude-3-haiku, gemini-1.5-pro, v.v.)
OMNIROUTE_MODEL=gpt-4o

# 3. KHO MÃ NGUỒN GITHUB (DÙNG CHO TỰ ĐỘNG CẬP NHẬT 1-CLICK)
GITHUB_REPO_URL=https://github.com/aixuanvuong/ql_server
